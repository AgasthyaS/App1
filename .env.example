# Supabase — copy this file to `.env` and fill in the two values from
# your Supabase project: Dashboard → Project Settings → API.
# The anon key is safe to ship in a client app (it only works alongside
# Row Level Security, which we enable on the database).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtueXltd3ZycWl0cHRmemNreXZmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMyMjU5NDMsImV4cCI6MjA5ODgwMTk0M30.yPwANlvW6i_F8fnSuAfaCyGccXIJo2Pny83I7tRYtf0
# Private — put the real value in .env (NOT here). This template stays public.
SUPABASE_SERVICE_ROLE=YOUR-SERVICE-ROLE-SECRET

# Gemini — used ONLY by the Supabase edge function `identify-plant`, never by the
# app. Do NOT put the real key in any file in this repo, and never give it an
# EXPO_PUBLIC_ prefix (that would bundle it into the app). Set it as a secret:
#
#   supabase secrets set GEMINI_API_KEY=your-key
#
# Optional overrides (defaults shown):
#   supabase secrets set IDENTIFY_MODEL=gemini-3.1-flash-lite
#   supabase secrets set IDENTIFY_ESCALATION_MODEL=gemini-3.5-flash-lite   # or "none"
GEMINI_API_KEY=YOUR-GEMINI-KEY-SET-AS-A-SUPABASE-SECRET-NOT-HERE
