# Supabase — copy this file to `.env` and fill in the two values from
# your Supabase project: Dashboard → Project Settings → API.
# The anon key is safe to ship in a client app (it only works alongside
# Row Level Security, which we enable on the database).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
