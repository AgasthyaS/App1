{
  "expo": {
    "name": "greenr",
    "slug": "App1",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greenr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B120E",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B120E"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B120E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Greenr uses your location once to read your area's climate and suggest plants that thrive nearby. It isn't stored or shared."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Greenr uses your photos so a picture of your plant becomes its picture in the app.",
          "cameraPermission": "Greenr uses the camera so you can photograph your plant and it becomes its picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Greenr uses the camera so you can photograph your plant and it becomes its picture."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Greenr uses Bluetooth once during setup to connect your plant sensor to your Wi-Fi."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
